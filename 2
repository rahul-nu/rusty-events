mod config;
mod events;

use crate::events::ChangeMin;
use config::Config;
use events::GerritEvent;
use std::fmt::Write;
use std::io::{BufRead, BufReader};
use std::path::PathBuf;
use std::process::{Command, Stdio};
use std::sync::Arc;
use threadpool::ThreadPool;

fn main() {
    let config_path = std::env::args()
        .nth(1)
        .map(PathBuf::from)
        .unwrap_or_else(|| PathBuf::from("gerrit-sync.toml"));

    let config = Config::load(&config_path);

    let pool = Box::leak(Box::new(ThreadPool::new(3)));
    pool.execute(move || fetch(&[], config));

    let pool2 = Box::leak(Box::new(ThreadPool::new(3)));

    pool.execute({
        let pool = &*pool2;
        move || sync_active(config, pool)
    });
    let mut cmd = Command::new("ssh");
    cmd.arg(&config.gerrit_server)
        .arg("gerrit")
        .arg("stream-events");

    for event in &config.events {
        cmd.arg("-s").arg(event);
    }

    let mut child = cmd.stdout(Stdio::piped()).spawn().unwrap();

    let stdout = child.stdout.take().expect("Failed to capture stdout");
    let reader = BufReader::new(stdout);

    for line in reader.lines() {
        let line = line.unwrap();
        pool.execute({
            let pool = &*pool2;
            move || match serde_json::from_str::<GerritEvent>(&line) {
                Ok(event) => {
                    println!("{:?}", event);
                    handle_event(event, config, pool)
                }
                Err(_) => {
                    eprintln!("warning: failed to deserialize event");
                    println!("{line}");
                }
            }
        });
    }
    child.wait().unwrap();

    eprintln!("gerrit stream-events channel closed.");
}

fn sync_active(cfg: &'static Config, pool: &'static ThreadPool) {
    let mut cmd = Command::new("ssh");
    let out = cmd
        .arg(&cfg.gerrit_server)
        .arg("gerrit")
        .arg("query")
        .arg("--format=JSON")
        .arg("status:open")
        .arg(format!("project:{}", cfg.repo))
        .output()
        .unwrap();
    let stdout = String::from_utf8(out.stdout).unwrap();

    let changes: Arc<Vec<_>> = Arc::new(
        stdout
            .lines()
            .filter(|line| !line.trim().is_empty())
            .filter_map(|line| {
                let x = serde_json::from_str::<ChangeMin>(line).ok();
                if x.is_none() {
                    println!("failed to deserialize {}", line);
                };
                x
            })
            .map(|change| change.number)
            .collect(),
    );

    for jj_dir in cfg.jj_dirs.iter() {
        let changes = changes.clone();
        pool.execute(move || append_to_active(changes, jj_dir));
    }
}

fn handle_event<'a>(event: GerritEvent<'a>, cfg: &'static Config, pool: &'static ThreadPool) {
    let project = match event.project() {
        None => return,
        Some(project) => project,
    };
    if project != cfg.repo.as_str() {
        return;
    }
    println!("{:?}", event.project());
    match event {
        GerritEvent::ChangeAbandoned { change, .. } | GerritEvent::ChangeMerged { change, .. } => {
            for jj_dir in cfg.jj_dirs.iter() {
                pool.execute(move || remove_from_active(change.number, jj_dir));
            }
        }
        GerritEvent::PatchsetCreated {
            patch_set, change, ..
        }
        | GerritEvent::ChangeRestored {
            patch_set, change, ..
        } => {
            fetch(&[patch_set.ref_string], cfg);
            let change_nums = Arc::new(vec![change.number]);
            for jj_dir in cfg.jj_dirs.iter() {
                let change_nums = change_nums.clone();
                pool.execute(move || append_to_active(change_nums, jj_dir));
            }
        }
        GerritEvent::DroppedOutput => {
            pool.execute(move || sync_active(cfg, &*pool));
            fetch(&[], cfg);
        }
        GerritEvent::RefUpdated { ref_update, .. } => fetch(&[ref_update.ref_name], cfg),
        GerritEvent::BatchRefUpdated { ref_updates, .. } => {
            let refs: Vec<_> = ref_updates
                .into_iter()
                .filter(|ru| ru.project == cfg.repo)
                .map(|ru| ru.ref_name)
                .collect();
            fetch(refs.as_slice(), cfg)
        }
        _ => (),
    }
}

fn append_to_active(change_nums: Arc<Vec<u32>>, jj_dir: &PathBuf) {
    println!("{:?}, {:?}", change_nums, jj_dir);
    let out = Command::new("jj")
        .arg("config")
        .arg("get")
        .arg(r#"revset-aliases."active()""#)
        .current_dir(jj_dir)
        .output()
        .unwrap();
    let mut arg = String::from_utf8(out.stdout).unwrap();
    for cn in change_nums.iter() {
        write!(&mut arg, r#" | tags("changes/{}/{}/*")"#, cn % 100, cn).unwrap();
    }
    Command::new("jj")
        .arg("config")
        .arg("set")
        .arg("--repo")
        .arg(r#"revset-aliases."active()""#)
        .arg(arg)
        .current_dir(jj_dir)
        .output()
        .unwrap();
}

fn remove_from_active(change_num: u32, jj_dir: &PathBuf) {
    let out = Command::new("jj")
        .arg("config")
        .arg("get")
        .arg(r#"revset-aliases."active()""#)
        .current_dir(jj_dir)
        .output()
        .unwrap();

    let mut arg = String::from_utf8(out.stdout).unwrap();

    let clause = format!(
        r#" | tags("changes/{}/{}/*")"#,
        change_num % 100,
        change_num
    );

    if let Some(pos) = arg.find(&clause) {
        arg.replace_range(pos..pos + clause.len(), "");
    }

    Command::new("jj")
        .arg("config")
        .arg("set")
        .arg("--repo")
        .arg(r#"revset-aliases."active()""#)
        .arg(arg.trim_end())
        .current_dir(jj_dir)
        .output()
        .unwrap();
}

fn fetch<'a>(refs: &'a [&'a str], cfg: &'static Config) {
    let mut cmd = Command::new("git");
    cmd.arg(format!("--git-dir={}", cfg.git_dir.display()))
        .arg("fetch")
        .arg("origin");
    for ref_string in refs.iter() {
        cmd.arg(ref_string);
    }
    assert!(cmd.status().unwrap().success());
}
